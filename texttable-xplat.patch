 # define a function to calculate the rendering width of a unicode character
 # - use wcwidth if available
 # - fallback to unicodedata information otherwise
+#
+# Both branches must agree on which characters occupy no column, otherwise the
+# very same input renders at a different width depending on whether the optional
+# (and undeclared) wcwidth package happens to be installed. The fallback used to
+# do four things differently from wcwidth:
+#
+#   1. it counted control / format / separator characters (Cc, Cf, Zl, Zp) as one
+#      column although a terminal gives them none. A cell holding a trailing CR
+#      -- the usual result of reading a text file on Windows with newline='' --
+#      was therefore measured one column too wide, and since textwrap then
+#      silently drops the CR as whitespace the border no longer matched the row;
+#   2. it tested east-asian-width *before* the combining mark, so characters such
+#      as U+3099 COMBINING KATAKANA-HIRAGANA VOICED SOUND MARK were reported as
+#      two columns wide instead of zero;
+#   3. it did not know about combining marks in the Mc (spacing combining) class;
+#   4. it did not know that Hangul medial vowels / final consonants combine with
+#      the preceding leading consonant and occupy no column of their own.
+#
+# The tables below are derived from the intersection of wcwidth 0.2.13 and 0.9.2
+# (the range still published for Python 2 era code and the current one) so that
+# this fallback agrees with every supported wcwidth release rather than with one
+# particular snapshot.
+#
+# Cf entries on which wcwidth releases *disagree*, so they cannot be aligned with
+# the fallback: some releases report 1 column for these, others 0.
+_CF_NOT_ZERO_WIDTH = frozenset((
+    0x00AD, 0x0600, 0x0601, 0x0602, 0x0603, 0x0604, 0x0605, 0x06DD, 0x070F,
+    0x0890, 0x0891, 0x08E2, 0x110BD, 0x110CD,
+))
+
+# Hangul medial vowels and final consonants are category Lo, yet they combine
+# with the preceding leading consonant and take no column of their own.
+_ZERO_WIDTH_RANGES = (
+    (0x1160, 0x11FF),
+    (0xD7B0, 0xD7FF),
+)
+
+
+def _in_zero_width_range(c):
+    cp = ord(c)
+    for low, high in _ZERO_WIDTH_RANGES:
+        if low <= cp <= high:
+            return True
+    return False
